{
  "name": "@slicemedia/swiper-adapter",
  "version": "0.1.0",
  "private": false,
  "description": "A reversible, responsive Swiper lifecycle adapter for Webflow projects.",
  "license": "MIT",
  "author": "Slice Media",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webflow": {
      "types": "./dist/webflow.d.ts",
      "import": "./dist/webflow.js"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicemedia/swiper-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/slicemedia/swiper-adapter/issues"
  },
  "homepage": "https://github.com/slicemedia/swiper-adapter#readme",
  "keywords": [
    "slicemedia",
    "swiper",
    "webflow",
    "slider",
    "carousel"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check && pnpm test:packed-consumer && pnpm sanitize",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "node scripts/check-pack.mjs",
    "release:archive": "node scripts/prepare-npm-publication.mjs",
    "release:prepare:check": "node scripts/assert-release-preparation-safe.mjs",
    "release:publish:check": "node scripts/assert-publish-next-safe.mjs",
    "sanitize": "node scripts/sanitize.mjs",
    "test": "node --test scripts/*.test.mjs && vitest run src --environment jsdom",
    "test:packed-consumer": "node scripts/test-packed-consumer.mjs",
    "test:watch": "vitest src --environment jsdom",
    "typecheck": "tsc -p tsconfig.json",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "peerDependencies": {
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "swiper": "^14.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
